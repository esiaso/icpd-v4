# Copy to prod.env (never commit it) and fill in. Generate secrets with: openssl rand -hex 32
APP_URL=https://cpd.example.org
WEB_PORT=3100
ICPD_TAG=latest

POSTGRES_USER=icpd
POSTGRES_PASSWORD=
POSTGRES_DB=icpd

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="ICPD <no-reply@example.org>"

# DigitalOcean Spaces (or http://minio:9000 with --profile minio)
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_BUCKET=
S3_KEY=
S3_SECRET=
BACKUP_BUCKET=

RECAPTCHA_SECRET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

SSO_SERVER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

CPD_ANNUAL_REQUIREMENT=50
MAX_UPLOAD_MB=10

# Used once by the seed command; change the password after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
