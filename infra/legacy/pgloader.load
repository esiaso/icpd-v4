-- Load the legacy MySQL database into the "legacy" schema of the ICPD v4 PostgreSQL database.
-- Usage: edit the two connection strings, then `pgloader infra/legacy/pgloader.load`.
LOAD DATABASE
  FROM mysql://USER:PASSWORD@MYSQL_HOST:3306/cpd_2021
  INTO postgresql://icpd:icpd@localhost:55433/icpd

WITH include drop, create tables, create no indexes, reset no sequences,
     preserve index names, workers = 4, concurrency = 2

-- keep legacy identifiers in their own schema and lower-case them
ALTER SCHEMA 'cpd_2021' RENAME TO 'legacy'

CAST type datetime to timestamp drop default drop not null using zero-dates-to-null,
     type date drop not null drop default using zero-dates-to-null,
     type tinyint to smallint drop typemod

BEFORE LOAD DO
  $$ CREATE SCHEMA IF NOT EXISTS legacy; $$;
